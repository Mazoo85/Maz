# Test fixture for `render_probe`: a two-part composite kept centered on the origin so the pixel
# assertions (lit center, clear corners) hold. Exercises the bake path — primitive generation,
# per-part transform, and mesh merge — end to end through the off-screen renderer.
maz-asset 1
name "Probe Asset"
kind item
part
  name "Core"
  prim box
  size 1 1 1
  pos 0 0 0
  rot 0 0 0
  scale 1 1 1
part
  name "Detail"
  prim box
  size 0.6 0.6 0.6
  pos 0 0 0
  rot 0 20 0
  scale 1 1 1
