.DS_Store
node_modules/
*.log

# C++ / CMake build artifacts
build/
build-*/
out/
cmake-build-*/

# Packaged game bundles (tools/package.sh output)
dist/

# Doxygen HTML output (docs/API.md is the committed, tool-free reference)
docs/api-html/
*.o
*.obj
*.spv
compile_commands.json
CMakeUserPresets.json
_deps/
Testing/

# Playwright is installed on demand for the arcade's browser suites
# (npm --prefix music/tests install), so its lockfile is local scratch.
package-lock.json

# Python (crew, the Forge, maz-scrape)
__pycache__/
*.pyc

# maz-scrape run state + its default output directory
.scraper/
/scraped/

# The Forge's run state. Its ledger under forge/ledger/ IS committed — that is
# the record of what the nightly loop did; only the scratch state is ignored.
forge/state/

# Crew's run state — its session checkpoint, written after every phase so a
# run can be resumed. The same kind of thing as .scraper/ and forge/state/
# above, and it was the only one of the three left out.
#
# That omission had teeth once the Forge started handing work to Crew for
# real: the Forge asks git what Crew changed, git reported this checkpoint as
# a new file outside every safe zone, and the leash refused the night's work.
# Every live run failed the same way, blaming Crew for its own bookkeeping.
.crew/
